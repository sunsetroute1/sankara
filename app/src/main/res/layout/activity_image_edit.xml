<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/editAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appSurface"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/edit_toolbar"
                style="@style/Widget.Sankara.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@android:drawable/ic_menu_revert"
                app:title="@string/image_edit_title" />

            <include layout="@layout/include_pan_african_stripe" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sankara_space_xl">

            <TextView
                android:id="@+id/editPanelInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/appAccent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sankara_space_xs"
                android:layout_marginBottom="@dimen/sankara_space_lg"
                android:text="@string/image_edit_subtitle"
                android:textAppearance="@style/TextAppearance.Sankara.Caption" />

            <androidx.cardview.widget.CardView
                style="@style/Widget.Sankara.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/editPreviewImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/image_preview_content_description"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />
            </androidx.cardview.widget.CardView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/editToolChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCrop"
                        style="@style/Widget.Sankara.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/image_edit_crop" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFitPanel"
                        style="@style/Widget.Sankara.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/image_edit_fit_panel" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRotate"
                        style="@style/Widget.Sankara.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/image_edit_rotate" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFlipH"
                        style="@style/Widget.Sankara.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/image_edit_flip_h" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFlipV"
                        style="@style/Widget.Sankara.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/image_edit_flip_v" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipInvert"
                        style="@style/Widget.Sankara.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/image_edit_invert" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEinkEnhance"
                        style="@style/Widget.Sankara.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/image_edit_eink_enhance" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReset"
                        style="@style/Widget.Sankara.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/image_edit_reset" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/image_edit_contrast"
                android:textColor="?attr/appTextMuted"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderContrast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0.5"
                android:valueTo="2.0"
                android:stepSize="0.05"
                android:value="1.0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/image_edit_brightness"
                android:textColor="?attr/appTextMuted"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="-100"
                android:valueTo="100"
                android:stepSize="1"
                android:value="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/image_edit_threshold"
                android:textColor="?attr/appTextMuted"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="255"
                android:stepSize="1"
                android:value="128" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncToCase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/flashButtonText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickAgain"
                style="@style/Widget.Sankara.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/image_preview_pick_again" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelEdit"
                style="@style/Widget.Sankara.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textColor="?attr/appTextMuted" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
