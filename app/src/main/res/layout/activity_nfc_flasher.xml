<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    tools:context=".NfcFlasher">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/nfcAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appSurface"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/nfc_toolbar"
                style="@style/Widget.Sankara.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@android:drawable/ic_menu_revert"
                app:title="@string/nfc_sync_title" />

            <include layout="@layout/include_pan_african_stripe" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sankara_space_xl">

            <!-- Dedicated clear-panel flow (replaces sync UI while active) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/clearPanelCard"
                style="@style/Widget.Sankara.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/sankara_space_xl">

                    <TextView
                        android:id="@+id/clearPanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/nfc_clear_panel_title"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/clearPanelDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/nfc_clear_panel_waiting"
                        android:textColor="?attr/appTextMuted"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/clear_panel_preview_frame" />

                    <ProgressBar
                        android:id="@+id/clearPanelProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:max="100"
                        android:min="0"
                        android:scaleY="3"
                        android:theme="@style/ProgressBarStyle"
                        android:visibility="gone"
                        tools:progress="42"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/clearPanelPercent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="end"
                        android:textColor="?attr/appAccent"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="42%"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelClearPanel"
                        style="@style/Widget.Sankara.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/nfc_clear_panel_cancel" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearPanelDone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/nfc_btn_done"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearPanelRetry"
                        style="@style/Widget.Sankara.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nfc_clear_panel_retry"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/syncMainContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- NFC status card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/nfcStatusCard"
                style="@style/Widget.Sankara.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sankara_space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/nfcStatusDot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/nfc_status_dot" />

                        <TextView
                            android:id="@+id/nfcStatusTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Listening for module…" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/nfcStatusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?attr/appTextMuted"
                        android:textSize="13sp"
                        tools:text="Hold upper-back of phone on the coil." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenNfcSettings"
                        style="@style/Widget.Sankara.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_open_nfc"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Panel settings shortcut -->
            <TextView
                android:id="@+id/nfcPanelSettingsLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sankara_space_md"
                android:background="@drawable/sankara_chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="@dimen/sankara_space_md"
                android:paddingVertical="@dimen/sankara_space_md"
                android:textColor="?attr/appAccent"
                android:textSize="12sp"
                tools:text="Panel: 2.7 inch · Black &amp; white — tap to change" />

            <!-- Image preview -->
            <androidx.cardview.widget.CardView
                android:id="@+id/previewImageWrapper"
                style="@style/Widget.Sankara.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/appSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/imagePreviewText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/imagePreviewText"
                        android:textColor="?attr/appAccent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/previewImageView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/image_preview_content_description"
                        android:scaleType="fitCenter"
                        app:srcCompat="@android:drawable/stat_sys_warning" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/nfc_btn_start_sync" />

            <!-- Transfer overlay (shown during write) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/whileFlashingArea"
                style="@style/Widget.Sankara.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sankara_space_lg"
                android:visibility="gone"
                tools:visibility="visible">

                <include layout="@layout/nfc_write_dialog" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/postTransferActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetrySync"
                        style="@style/Widget.Sankara.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/nfc_btn_retry" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDoneSync"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nfc_btn_done" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearPanel"
                    style="@style/Widget.Sankara.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/nfc_btn_clear_panel" />
            </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
