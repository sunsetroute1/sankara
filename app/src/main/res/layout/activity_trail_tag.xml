<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/trailTagAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appSurface"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/trail_tag_toolbar"
                style="@style/Widget.Sankara.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@android:drawable/ic_menu_revert"
                app:title="@string/trail_tag_title" />

            <include layout="@layout/include_pan_african_stripe" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/trailTagScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sankara_space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sankara_space_lg"
                android:text="@string/trail_tag_subtitle"
                android:textAppearance="@style/TextAppearance.Sankara.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trail_tag_status_section"
                android:textAppearance="@style/TextAppearance.Sankara.Section"
                android:textColor="?attr/colorSecondary" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sankara_space_md"
                android:layout_marginBottom="@dimen/sankara_space_md"
                app:cardBackgroundColor="?attr/appSurfaceElevated"
                app:cardCornerRadius="@dimen/sankara_radius_md"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sankara_space_lg">

                    <TextView
                        android:id="@+id/trailTagStatusLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sankara.Title"
                        android:textSize="16sp"
                        tools:text="Active Adventure" />

                    <TextView
                        android:id="@+id/trailTagStatusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sankara_space_sm"
                        android:textAppearance="@style/TextAppearance.Sankara.Body"
                        tools:text="Dale Ball Trail Run" />

                    <TextView
                        android:id="@+id/trailTagStatusTimes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sankara_space_xs"
                        android:textAppearance="@style/TextAppearance.Sankara.Caption"
                        tools:text="Started 7:42 AM · Return 11:30 AM" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trail_tag_profile_section"
                android:textAppearance="@style/TextAppearance.Sankara.Section"
                android:textColor="?attr/colorPrimary" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sankara_space_md"
                android:layout_marginBottom="@dimen/sankara_space_lg"
                app:cardBackgroundColor="?attr/appSurfaceElevated"
                app:cardCornerRadius="@dimen/sankara_radius_md"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sankara_space_lg">

                    <TextView
                        android:id="@+id/trailTagProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sankara.Title"
                        android:textSize="16sp"
                        tools:text="Morgan Mo" />

                    <TextView
                        android:id="@+id/trailTagProfileContacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sankara_space_xs"
                        android:textAppearance="@style/TextAppearance.Sankara.Body"
                        tools:text="Emergency contacts: 2" />

                    <TextView
                        android:id="@+id/trailTagProfileTracking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Sankara.Body"
                        tools:text="Tracking services: 3" />

                    <TextView
                        android:id="@+id/trailTagSharingMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sankara_space_sm"
                        android:textAppearance="@style/TextAppearance.Sankara.Caption"
                        tools:text="Local only" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sankara_space_md"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrailTagProfile"
                    style="@style/Widget.Sankara.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/sankara_space_sm"
                    android:layout_weight="1"
                    android:text="@string/trail_tag_create_local_profile" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrailTagPublish"
                    style="@style/Widget.Sankara.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trail_tag_publish_emergency_page" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrailTagStart"
                style="@style/Widget.Sankara.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sankara_space_md"
                android:text="@string/trail_tag_start_adventure" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trail_tag_template_section"
                android:textAppearance="@style/TextAppearance.Sankara.Section"
                android:textColor="?attr/appAccent" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/trailTagTemplateChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sankara_space_sm"
                android:layout_marginBottom="@dimen/sankara_space_md"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTemplateActive"
                    style="@style/Widget.Sankara.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/trail_tag_template_active" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTemplateVehicle"
                    style="@style/Widget.Sankara.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trail_tag_template_vehicle" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTemplateEmergency"
                    style="@style/Widget.Sankara.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trail_tag_template_emergency" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trail_tag_preview_section"
                android:textAppearance="@style/TextAppearance.Sankara.Section"
                android:textColor="?attr/appTextPrimary" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sankara_space_sm"
                android:layout_marginBottom="@dimen/sankara_space_sm"
                app:cardBackgroundColor="?attr/appSurfaceElevated"
                app:cardCornerRadius="@dimen/sankara_radius_md"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/trailTagPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/trail_tag_preview_content_desc"
                    android:padding="@dimen/sankara_space_md"
                    android:scaleType="fitCenter" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/trailTagDisplaySyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sankara_space_md"
                android:textAppearance="@style/TextAppearance.Sankara.Caption"
                tools:text="Display status: Synced 2 minutes ago" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrailTagSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sankara_space_md"
                android:text="@string/trail_tag_update_display"
                app:icon="@android:drawable/ic_menu_upload"
                app:iconGravity="textStart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sankara_space_xxl"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrailTagEnd"
                    style="@style/Widget.Sankara.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/sankara_space_sm"
                    android:layout_weight="1"
                    android:text="@string/trail_tag_end_adventure" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrailTagPublicProfile"
                    style="@style/Widget.Sankara.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trail_tag_share_profile" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
