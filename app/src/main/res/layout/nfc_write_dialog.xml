<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/sankara_space_xl">

    <TextView
        android:id="@+id/transferStepLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nfc_status_transferring"
        android:textColor="?attr/appTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pleaseWaitText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/pleaseWaitWhileFlashingText"
        android:textColor="?attr/appTextMuted"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/nfcFlashProgressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        android:min="0"
        android:scaleY="3"
        android:theme="@style/ProgressBarStyle"
        tools:progress="42" />

    <TextView
        android:id="@+id/transferProgressPercent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:textColor="?attr/appAccent"
        android:textSize="12sp"
        tools:text="42%" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelSync"
        style="@style/Widget.Sankara.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/nfc_btn_cancel_sync" />

</LinearLayout>
