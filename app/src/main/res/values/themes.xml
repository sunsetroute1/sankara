<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Sankara" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/sankara_red</item>
        <item name="colorPrimaryVariant">@color/sankara_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sankara_green</item>
        <item name="colorSecondaryVariant">@color/sankara_green_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/sankara_charcoal</item>
        <item name="colorSurface">@color/sankara_surface</item>
        <item name="colorOnSurface">@color/sankara_text_primary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/sankara_charcoal</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="l">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="materialSwitchStyle">@style/Widget.Sankara.Switch</item>
        <item name="materialButtonStyle">@style/Widget.Sankara.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Sankara.Button.Outlined</item>
    </style>

    <style name="Widget.Sankara.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/sankara_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.Sankara.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/sankara_green</item>
        <item name="android:textColor">@color/sankara_text_primary</item>
    </style>

    <style name="Widget.Sankara.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/sankara_green</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Sankara.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:textOn">@null</item>
        <item name="android:textOff">@null</item>
        <item name="android:showText">false</item>
    </style>

    <style name="Widget.Sankara.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/sankara_surface</item>
        <item name="titleTextColor">@color/sankara_text_primary</item>
        <item name="subtitleTextColor">@color/sankara_gold</item>
    </style>

    <style name="ProgressBarStyle">
        <item name="colorAccent">@color/sankara_gold</item>
    </style>

    <!-- Legacy alias for NFC flasher layouts -->
    <style name="Theme.NFCEInkWriter" parent="Theme.Sankara" />

    <!-- CanHub crop screen: light toolbar so the "Crop" text action is visible. -->
    <style name="Theme.Sankara.Crop" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/sankara_border</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/sankara_border</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="actionMenuTextColor">@color/sankara_green</item>
        <item name="android:actionMenuTextColor">@color/sankara_green</item>
    </style>
</resources>
